using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Text;
using System.Windows.Forms;
using Mon_Secret.Controllers;
using Mon_Secret.Models;

namespace Mon_Secret.Views.Contacts
{
    public partial class ContactControl : UserControl
    {
        private readonly int userId;
        private readonly ContactController contactController;
        private DataTable contactsTable = null!;

        public ContactControl() : this(0)
        {
        }

        public ContactControl(int userId)
        {
            InitializeComponent();

            this.userId = userId;
            contactController = new ContactController();

            ConfigurerDataGridView();
            textRecherche.TextChanged += textRecherche_TextChanged;
            btnAjouterContact.Click += btnAjouterContact_Click;
            dataGridView1.CellClick += dataGridView1_CellClick;
            dataGridView1.CellPainting += dataGridView1_CellPainting;

            ChargerContacts();
        }

        private void ConfigurerDataGridView()
        {
            dataGridView1.BackgroundColor = Color.White;
            dataGridView1.BorderStyle = BorderStyle.None;
            dataGridView1.EnableHeadersVisualStyles = false;
            dataGridView1.ColumnHeadersDefaultCellStyle.BackColor = Color.MidnightBlue;
            dataGridView1.ColumnHeadersDefaultCellStyle.ForeColor = Color.White;
            dataGridView1.ColumnHeadersDefaultCellStyle.Font = new Font("Segoe UI", 10, FontStyle.Bold);
            dataGridView1.DefaultCellStyle.Font = new Font("Segoe UI", 9);
            dataGridView1.DefaultCellStyle.SelectionBackColor = Color.LightSteelBlue;
            dataGridView1.DefaultCellStyle.SelectionForeColor = Color.Black;
            dataGridView1.RowHeadersVisible = false;
            dataGridView1.AllowUserToAddRows = false;
            dataGridView1.AllowUserToDeleteRows = false;
            dataGridView1.AllowUserToResizeRows = false;
            dataGridView1.ReadOnly = true;
            dataGridView1.MultiSelect = false;
            dataGridView1.SelectionMode = DataGridViewSelectionMode.FullRowSelect;
            dataGridView1.AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.None;
            dataGridView1.ScrollBars = ScrollBars.Horizontal;
            dataGridView1.ColumnHeadersHeight = 40;
            dataGridView1.RowTemplate.Height = 35;

            dataGridView1.Columns["colNom"].Width = 100;
            dataGridView1.Columns["colPrenom"].Width = 100;
            dataGridView1.Columns["colTelephone"].Width = 110;
            dataGridView1.Columns["colEmail"].Width = 160;
            dataGridView1.Columns["colAdresse"].Width = 160;

            dataGridView1.Columns["colActions"].Width = 125;
            dataGridView1.Columns["colActions"].DefaultCellStyle.Alignment =
                DataGridViewContentAlignment.MiddleCenter;

            dataGridView1.Columns["colNom"].DataPropertyName = "nom";
            dataGridView1.Columns["colPrenom"].DataPropertyName = "prenom";
            dataGridView1.Columns["colTelephone"].DataPropertyName = "telephone";
            dataGridView1.Columns["colEmail"].DataPropertyName = "email";
            dataGridView1.Columns["colAdresse"].DataPropertyName = "adresse";
        }

        private void ChargerContacts()
        {
            if (userId <= 0)
                return;

            try
            {
                contactsTable = contactController.AfficherContacts(userId);
                dataGridView1.DataSource = contactsTable;
                AppliquerFiltre();
            }
            catch (Exception ex)
            {
                AfficherErreur("Erreur lors du chargement des contacts : " + ex.Message);
            }
        }

        private void AppliquerFiltre()
        {
            if (dataGridView1.DataSource is not DataTable table)
                return;

            string recherche = textRecherche.Text.Trim().Replace("'", "''");
            if (string.IsNullOrWhiteSpace(recherche))
            {
                table.DefaultView.RowFilter = "";
                return;
            }

            table.DefaultView.RowFilter =
                $"nom LIKE '%{recherche}%' OR prenom LIKE '%{recherche}%' OR " +
                $"telephone LIKE '%{recherche}%' OR email LIKE '%{recherche}%' OR adresse LIKE '%{recherche}%'";
        }

        private void textRecherche_TextChanged(object? sender, EventArgs e) => AppliquerFiltre();

        private void btnAjouterContact_Click(object? sender, EventArgs e)
        {
            if (!VerifierUtilisateur())
                return;

            using var form = new AjouterContactForm(userId);
            if (form.ShowDialog(this) == DialogResult.OK)
                ChargerContacts();
        }

        private void dataGridView1_CellClick(object? sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex < 0 || e.ColumnIndex < 0 || !VerifierUtilisateur(false))
                return;

            try
            {
                if (dataGridView1.Rows[e.RowIndex].DataBoundItem is not DataRowView data)
                    return;

                int contactId = Convert.ToInt32(data["id"]);
                if (dataGridView1.Columns[e.ColumnIndex].Name != "colActions")
                    return;

                int largeurAction = dataGridView1.Columns[e.ColumnIndex].Width;
                if (e.X < largeurAction / 3)
                    VoirContact(contactId);
                else if (e.X < largeurAction * 2 / 3)
                    ModifierContact(contactId);
                else
                    SupprimerContact(contactId);
            }
            catch (Exception ex)
            {
                AfficherErreur("Erreur lors de l'action : " + ex.Message);
            }
        }

        private void dataGridView1_CellPainting(object? sender, DataGridViewCellPaintingEventArgs e)
        {
            if (e.RowIndex < 0 || e.ColumnIndex < 0)
                return;

            string column = dataGridView1.Columns[e.ColumnIndex].Name;
            if (column != "colActions")
                return;

            e.PaintBackground(e.CellBounds, true);
            using Font font = new Font("Segoe UI Symbol", 14, FontStyle.Bold);
            TextRenderer.DrawText(e.Graphics, "◉", font,
                new Point(e.CellBounds.Left + 13, e.CellBounds.Top + 7), Color.DodgerBlue);
            TextRenderer.DrawText(e.Graphics, "✎", font,
                new Point(e.CellBounds.Left + 55, e.CellBounds.Top + 7), Color.DarkOrange);
            TextRenderer.DrawText(e.Graphics, "✖", font,
                new Point(e.CellBounds.Left + 97, e.CellBounds.Top + 7), Color.Firebrick);
            e.Handled = true;
        }

        private void VoirContact(int contactId)
        {
            using var form = new DetailsContactForm(userId, contactId);
            form.ShowDialog(this);
        }

        private void ModifierContact(int contactId)
        {
            using var form = new ModifierContactForm(userId, contactId);
            if (form.ShowDialog(this) == DialogResult.OK)
                ChargerContacts();
        }

        private void SupprimerContact(int contactId)
        {
            DialogResult confirmation = MessageBox.Show(
                "Voulez-vous vraiment supprimer ce contact ?", "Confirmation",
                MessageBoxButtons.YesNo, MessageBoxIcon.Warning);
            if (confirmation != DialogResult.Yes)
                return;

            if (contactController.SupprimerContact(contactId, userId, out string message))
                ChargerContacts();
            MessageBox.Show(message, "Suppression",
                MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        private bool VerifierUtilisateur(bool afficherMessage = true)
        {
            if (userId > 0)
                return true;

            if (afficherMessage)
                MessageBox.Show("Aucun utilisateur connecté.", "Accès refusé",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
            return false;
        }

        private static void AfficherErreur(string message)
        {
            MessageBox.Show(message, "Erreur", MessageBoxButtons.OK, MessageBoxIcon.Error);
        }
    }
}
