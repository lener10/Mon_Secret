using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Text;
using System.Windows.Forms;
using Mon_Secret.Controllers;
using Mon_Secret.Models;
using Mon_Secret.Views.Activites;

namespace Mon_Secret.Views.Contacts
{
    public partial class dgvActivites : UserControl
    {
        private readonly int userId;
        private readonly ActiviteController activiteController;
        private DataTable activitesTable = null!;

        public dgvActivites() : this(0)
        {
        }

        public dgvActivites(int userId)
        {
            InitializeComponent();

            this.userId = userId;
            activiteController = new ActiviteController();

            ConfigurerDataGridView();

            ConfigurerCategories();
            ConfigurerStatuts();

            txtRecherche.TextChanged += txtRecherche_TextChanged;

            cmbCategorie.SelectedIndexChanged += cmbCategorie_SelectedIndexChanged;

            cmbStatut.SelectedIndexChanged += cmbStatut_SelectedIndexChanged;

            dataGridView1.CellMouseClick += dataGridView1_CellMouseClick;
            dataGridView1.CellPainting += dataGridView1_CellPainting;

            ChargerActivites();
        }



        private void ConfigurerDataGridView()
        {
            // Apparence générale
            dataGridView1.BackgroundColor = Color.White;
            dataGridView1.BorderStyle = BorderStyle.None;

            // En-tête des colonnes
            dataGridView1.ColumnHeadersDefaultCellStyle.BackColor =
                Color.MidnightBlue;

            dataGridView1.ColumnHeadersDefaultCellStyle.ForeColor =
                Color.White;

            dataGridView1.ColumnHeadersDefaultCellStyle.Font =
                new Font("Segoe UI", 10, FontStyle.Bold);

            // Style des cellules
            dataGridView1.DefaultCellStyle.Font =
                new Font("Segoe UI", 9, FontStyle.Regular);

            dataGridView1.DefaultCellStyle.SelectionBackColor =
                Color.LightSteelBlue;

            dataGridView1.DefaultCellStyle.SelectionForeColor =
                Color.Black;

            // Comportement
            dataGridView1.EnableHeadersVisualStyles = false;
            dataGridView1.RowHeadersVisible = false;
            dataGridView1.AllowUserToAddRows = false;
            dataGridView1.AllowUserToDeleteRows = false;
            dataGridView1.AllowUserToResizeRows = false;

            dataGridView1.ReadOnly = true;
            dataGridView1.MultiSelect = false;

            dataGridView1.SelectionMode =
                DataGridViewSelectionMode.FullRowSelect;

            // Dimensions générales
            dataGridView1.Size = new Size(719, 228);

            dataGridView1.AutoSizeColumnsMode =
                DataGridViewAutoSizeColumnsMode.None;
            dataGridView1.ScrollBars = ScrollBars.Horizontal;

            dataGridView1.ColumnHeadersHeight = 40;
            dataGridView1.RowTemplate.Height = 35;

            // Largeur des colonnes
            dataGridView1.Columns["colTitre"].Width = 140;
            dataGridView1.Columns["colDescription"].Width = 220;
            dataGridView1.Columns["colDateHeure"].Width = 160;
            dataGridView1.Columns["colCategorie"].Width = 130;
            dataGridView1.Columns["colStatut"].Width = 110;

            dataGridView1.Columns["ColActions"].Width = 90;
            dataGridView1.Columns["ColActions"].DefaultCellStyle.Alignment =
                DataGridViewContentAlignment.MiddleCenter;

            // Association avec les champs de la base de données
            dataGridView1.Columns["colTitre"].DataPropertyName = "title";
            dataGridView1.Columns["colDescription"].DataPropertyName = "description";
            dataGridView1.Columns["colDateHeure"].DataPropertyName = "date_heure";
            dataGridView1.Columns["colCategorie"].DataPropertyName = "category";
            dataGridView1.Columns["colStatut"].DataPropertyName = "status";
            dataGridView1.Columns["colDateHeure"].DefaultCellStyle.Format =
                "dd/MM/yyyy HH:mm";
        }

        private void ConfigurerCategories()
        {
            cmbCategorie.Items.Clear();

            cmbCategorie.Items.Add("Toutes les catégories");
            cmbCategorie.Items.Add("Personnel");
            cmbCategorie.Items.Add("Études");
            cmbCategorie.Items.Add("Travail");
            cmbCategorie.Items.Add("Urgent");

            cmbCategorie.SelectedIndex = 0;
        }

        private void ConfigurerStatuts()
        {
            cmbStatut.Items.Clear();

            cmbStatut.Items.Add("Tous les statuts");
            cmbStatut.Items.Add("À faire");
            cmbStatut.Items.Add("En cours");
            cmbStatut.Items.Add("Terminée");

            cmbStatut.SelectedIndex = 0;
        }

        private void txtRecherche_TextChanged(object? sender, EventArgs e)
        {
            AppliquerFiltres();
        }

        private void cmbCategorie_SelectedIndexChanged(object? sender, EventArgs e)
        {
            AppliquerFiltres();
        }

        private void cmbStatut_SelectedIndexChanged(object? sender, EventArgs e)
        {
            AppliquerFiltres();
        }

        private void AppliquerFiltres()
        {
            if (dataGridView1.DataSource is not DataTable table)
                return;

            List<string> filtres = new List<string>();
            string recherche = txtRecherche.Text.Trim().Replace("'", "''");

            if (!string.IsNullOrWhiteSpace(recherche))
            {
                filtres.Add(
                    $"(title LIKE '%{recherche}%' OR description LIKE '%{recherche}%')");
            }

            if (!string.IsNullOrWhiteSpace(cmbCategorie.Text) &&
                cmbCategorie.Text != "Toutes les catégories")
            {
                string categorie = cmbCategorie.Text.Replace("'", "''");
                filtres.Add($"category = '{categorie}'");
            }

            if (!string.IsNullOrWhiteSpace(cmbStatut.Text) &&
                cmbStatut.Text != "Tous les statuts")
            {
                string statut = cmbStatut.Text.Replace("'", "''");
                filtres.Add($"status = '{statut}'");
            }

            table.DefaultView.RowFilter = string.Join(" AND ", filtres);
        }

        private void ChargerActivites()
        {
            if (userId <= 0)
                return;

            try
            {
                activitesTable = activiteController.AfficherActivites(userId);
                dataGridView1.DataSource = activitesTable;
                AppliquerFiltres();
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    ex.Message,
                    "Erreur",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error
                );
            }
        }

        private void btnAjouterActivite_Click(object? sender, EventArgs e)
        {
            if (userId <= 0)
            {
                MessageBox.Show(
                    "Aucun utilisateur connecté.",
                    "Accès refusé",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning
                );
                return;
            }

            using (AjouteActiviteForm form = new AjouteActiviteForm(userId))
            {
                if (form.ShowDialog(this) == DialogResult.OK)
                    ChargerActivites();
            }
        }

        private void dataGridView1_CellMouseClick(
            object? sender,
            DataGridViewCellMouseEventArgs e)
        {
            if (e.RowIndex < 0 || e.ColumnIndex < 0)
                return;

            try
            {
                string colonne = dataGridView1.Columns[e.ColumnIndex].Name;
                DataRowView data = (DataRowView)dataGridView1.Rows[e.RowIndex].DataBoundItem;
                int activiteId = Convert.ToInt32(data["id"]);

                if (colonne != "ColActions")
                    return;

                if (e.X < dataGridView1.Columns[e.ColumnIndex].Width / 2)
                    VoirActivite(activiteId);
                else
                    SupprimerActivite(activiteId);
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    "Erreur lors de l'action : " + ex.Message,
                    "Erreur",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error
                );
            }
        }

        private void dataGridView1_CellPainting(
            object? sender,
            DataGridViewCellPaintingEventArgs e)
        {
            if (e.RowIndex < 0 || e.ColumnIndex < 0 ||
                dataGridView1.Columns[e.ColumnIndex].Name != "ColActions")
            {
                return;
            }

            e.PaintBackground(e.CellBounds, true);

            using Font police = new Font("Segoe UI Symbol", 14, FontStyle.Bold);
            TextRenderer.DrawText(
                e.Graphics,
                "◉",
                police,
                new Point(e.CellBounds.Left + 14, e.CellBounds.Top + 7),
                Color.DodgerBlue);
            TextRenderer.DrawText(
                e.Graphics,
                "✖",
                police,
                new Point(e.CellBounds.Left + 53, e.CellBounds.Top + 7),
                Color.Crimson);

            e.Handled = true;
        }

        private void VoirActivite(int activiteId)
        {
            if (!activiteController.VoirActivite(
                activiteId,
                userId,
                out Activite activite,
                out string message))
            {
                MessageBox.Show(
                    message,
                    "Information",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning
                );
                return;
            }

            MessageBox.Show(
                $"Titre : {activite.Title}\n" +
                $"Description : {activite.Description}\n" +
                $"Date : {activite.DateHeure:dd/MM/yyyy HH:mm}\n" +
                $"Catégorie : {activite.Category}\n" +
                $"Statut : {activite.Status}",
                "Détails de l'activité",
                MessageBoxButtons.OK,
                MessageBoxIcon.Information
            );
        }

        private void SupprimerActivite(int activiteId)
        {
            DialogResult confirmation = MessageBox.Show(
                "Voulez-vous vraiment supprimer cette activité ?",
                "Confirmation de suppression",
                MessageBoxButtons.YesNo,
                MessageBoxIcon.Warning
            );

            if (confirmation != DialogResult.Yes)
                return;

            bool resultat = activiteController.SupprimerActivite(
                activiteId,
                userId,
                out string message
            );

            MessageBox.Show(
                message,
                resultat ? "Succès" : "Attention",
                MessageBoxButtons.OK,
                resultat ? MessageBoxIcon.Information : MessageBoxIcon.Warning
            );

            if (resultat)
                ChargerActivites();
        }

    }
}
